            message: 'Server error: ' + error.message 
        });
    }
};

// Get schedules for a destination
const getSchedulesByDestination = async (req, res) => {
    const { id } = req.params;
    
    try {
        const [schedules] = await db.promisePool.query(
            `SELECT id_schedule, tanggal_trip, kuota, status 
             FROM schedules 
             WHERE id_destination = ? AND tanggal_trip >= CURDATE()
             ORDER BY tanggal_trip ASC`,
            [id]
        );

        res.json({
            success: true,
            data: schedules
        });
    } catch (error) {
        console.error(error);
        res.status(500).json({ 
            success: false, 
            message: 'Server error: ' + error.message 
        });
    }
};

module.exports = { 
    getDestinations, 
    getDestinationById, 
    getPopularDestinations,
    getSchedulesByDestination 
};