const db = require('../config/database');

// Create new order
const createOrder = async (req, res) => {
    const { id_schedule, jumlah_orang, total_price, id_package } = req.body;
    const userId = req.user.id;

    const connection = await db.getConnection();
    
    try {
        await connection.beginTransaction();

        // Create order
        const [orderResult] = await connection.query(
            `INSERT INTO orders (id_user, total_price, status_order, id_package) 
             VALUES (?, ?, 'pending', ?)`,
            [userId, total_price, id_package || null]
        );

        const orderId = orderResult.insertId;

        // Create order detail
        await connection.query(
            `INSERT INTO order_details (id_order, id_schedule, jumlah_orang, subtotal) 
             VALUES (?, ?, ?, ?)`,
            [orderId, id_schedule, jumlah_orang, total_price]
        );

        // Update schedule quota
        await connection.query(
            `UPDATE schedules SET kuota = kuota - ? 
             WHERE id_schedule = ? AND kuota >= ?`,
            [jumlah_orang, id_schedule, jumlah_orang]
        );

        await connection.commit();

        res.status(201).json({
            success: true,
            message: 'Order created successfully',
            orderId: orderId
        });
    } catch (error) {
        await connection.rollback();
        console.error(error);
        res.status(500).json({ success: false, message: 'Server error' });
    } finally {
        connection.release();
    }
};

// Get user orders
const getUserOrders = async (req, res) => {
    const userId = req.user.id;

    try {
        const [orders] = await db.query(
            `SELECT o.id_order, o.tanggal_order, o.total_price, o.status_order,
                    d.nama_destination, s.tanggal_trip, od.jumlah_orang
             FROM orders o
             JOIN order_details od ON o.id_order = od.id_order
             JOIN schedules s ON od.id_schedule = s.id_schedule
             JOIN destinations d ON s.id_destination = d.id_destination
             WHERE o.id_user = ?
             ORDER BY o.tanggal_order DESC`,
            [userId]
        );

        res.json({
            success: true,
            data: orders
        });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: 'Server error' });
    }
};

// Get order by ID
const getOrderById = async (req, res) => {
    const { id } = req.params;
    const userId = req.user.id;

    try {
        const [orders] = await db.query(
            `SELECT o.*, od.jumlah_orang, s.tanggal_trip, s.id_schedule,
                    d.nama_destination, d.lokasi, d.harga
             FROM orders o
             JOIN order_details od ON o.id_order = od.id_order
             JOIN schedules s ON od.id_schedule = s.id_schedule
             JOIN destinations d ON s.id_destination = d.id_destination
             WHERE o.id_order = ? AND o.id_user = ?`,
            [id, userId]
        );

        if (orders.length === 0) {
            return res.status(404).json({
                success: false,
                message: 'Order not found'
            });
        }

        res.json({
            success: true,
            data: orders[0]
        });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: 'Server error' });
    }
};

// Update order status
const updateOrderStatus = async (req, res) => {
    const { id } = req.params;
    const { status_order } = req.body;

    try {
        await db.query(
            'UPDATE orders SET status_order = ? WHERE id_order = ?',
            [status_order, id]
        );

        res.json({
            success: true,
            message: 'Order status updated'
        });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: 'Server error' });
    }
};

module.exports = { createOrder, getUserOrders, getOrderById, updateOrderStatus };